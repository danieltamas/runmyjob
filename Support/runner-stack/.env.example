# Copy to .env next to docker-compose.yml, chmod 600. Never committed, never on the Mac.
# RMJ writes this file for you from the Keychain (Settings > Destinations); this is what it holds.
#
# One fine-grained personal access token per GitHub owner (github.com > Settings > Developer settings >
# Fine-grained tokens). A token has one resource owner.
#
# GH_PAT_<OWNER>   a user owner: repository access to the runner repos only; repository permission
#                  "Administration: Read and write" (the only one that may create a repo runner
#                  registration token). Expiry 90 days.
# GH_PAT_<ORG>     an org owner (the org must allow fine-grained tokens): organization permission
#                  "Self-hosted runners: Read and write"; no repository access needed.
GH_PAT_EXAMPLEUSER=
GH_PAT_EXAMPLEORG=
